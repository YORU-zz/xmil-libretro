+			if (cmt_rec) {
+				cmt_rec = FALSE;
+				cmt_rec_flush();
+				cmt_rec_chain = TRUE;
+			}
+			else {
+				cmt_rec_chain = FALSE;
+			}
 			iocore.s.ppib &= ~0x01;
 			break;
-#if 0
+
 		case 0x02:				/* PLAY */
+			if (cmt_rec) {
+				cmt_rec = FALSE;
+				cmt_rec_flush();
+			}
+			cmt_rec_chain = FALSE;
+			if (cmt_bits != NULL) {
+				cmt_playing = TRUE;
+				cmt_high = TRUE;
+				cmt_phase = 0;
+				cmt_lastclk = (UINT32)CPU_CLOCKCOUNT;
+			}
+			break;
+
 		case 0x03:				/* FF */
-		case 0x04:				/* REW */
