+			break;
+
+		case 0x04:				/* REW */
 		case 0x06:				/* APSS_REW */
+			cmt_playing = FALSE;
+			cmt_rec_chain = FALSE;
+			cmt_pos = 0;
+			break;
+
 		case 0x0a:				/* REC */
+			cmt_playing = FALSE;
+			cmt_rec = TRUE;
+			cmt_rec_n = 0;
+			cmt_rec_trunc = !cmt_rec_chain;
+			cmt_rec_chain = FALSE;
+			cmt_rec_level0 = cmt_wline;
+			cmt_rec_lastclk = (UINT32)CPU_CLOCKCOUNT;
+			break;
+
+		default:
+			cmt_playing = FALSE;
 			break;
-#endif	/* 0 */
 	}
 	cmt.cmd = (UINT8)cmd;
 }
 
 REG8 cmt_tape_stat(void) {
 
-	return(0);
+	if (cmt_bits == NULL) {
+		return(0);
+	}
+	/* bit0: tape rotating, bit1: tape set, bit2: write protect */
+	return(cmt_playing ? 0x03 : 0x02);
 }
 
 REG8 cmt_ctrl_stat(void) {
@@ -63,7 +476,11 @@ REG8 cmt_test(void) {
 void cmt_reset(void) {
 
 	cmt.cmd = 0;
-	/* cmt.stop = 1; */
 	iocore.s.ppib &= ~0x01;
+	cmt_rec = FALSE;
+	cmt_rec_chain = FALSE;
