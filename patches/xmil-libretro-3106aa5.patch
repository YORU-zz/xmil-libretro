 	switch(cmd) {
 		case 0x00:				/* EJECT */
+			cmt_playing = FALSE;
+			if (cmt_rec) {
+				cmt_rec = FALSE;
+				cmt_rec_flush();
+			}
+			cmt_rec_chain = FALSE;
+			cmt_pos = 0;
+			iocore.s.ppib &= ~0x01;
+			break;
+
 		case 0x01:				/* STOP */
-			/* cmt.stop = 1; */
